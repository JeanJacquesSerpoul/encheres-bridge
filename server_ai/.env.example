# Serveur IA du client bridge : proxy vers OpenRouter, seul fournisseur servi.
# Copiez ce fichier en .env et renseignez la clé.

PORT=9009

# Clé d'API OpenRouter (obligatoire) : elle reste ici, jamais dans le navigateur.
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# Modèle interrogé quand la requête n'en nomme pas.
DEFAULT_MODEL=google/gemini-3.1-flash-lite

# Plafond de tokens par réponse et délai d'attente d'OpenRouter, en secondes.
MAX_TOKENS=10000
TIMEOUT=60

# Origines CORS autorisées, séparées par des virgules (* par défaut).
# CORS_ORIGINS=https://bridge.example
