# Serveur IA du client bridge : proxy vers OpenRouter, seul fournisseur servi.
# Copiez ce fichier en .env et renseignez la clé.

PORT=9013

# Clé d'API OpenRouter (obligatoire) : elle reste ici, jamais dans le navigateur.
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# Modèle interrogé quand la requête n'en nomme pas.
DEFAULT_MODEL=google/gemini-3.1-flash-lite

# Plafond de tokens par réponse et délai d'attente d'OpenRouter, en secondes.
MAX_TOKENS=10000
TIMEOUT=60

# Modèles que /api/chat accepte en plus de DEFAULT_MODEL, séparés par des
# virgules. Vide : seul DEFAULT_MODEL est servi.
# ALLOWED_MODELS=google/gemini-3.1-pro

# Origines CORS autorisées, séparées par des virgules (* par défaut).
# En production, mettez l'origine du client.
# CORS_ORIGINS=https://bridge.example

# Limite de requêtes /api/* par IP et par minute (0 la désactive), et rafale
# tolérée au-delà.
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=5

# true seulement derrière un reverse proxy (Caddy…) qui réécrit
# X-Forwarded-For : sinon n'importe quel appelant choisit l'IP limitée.
TRUST_PROXY=false

# Expose GET /api/models (inutile au client, désactivé par défaut).
ENABLE_MODELS_ENDPOINT=false

# docker compose : interface où publier le port (127.0.0.1 par défaut).
# BIND_ADDR=127.0.0.1
